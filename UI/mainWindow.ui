        <property name="styleSheet">
         <string notr="true">QFrame#send_panel {
    background: #fffdf9;
    border: 1px solid #eee5da;
    border-radius: 18px;
}
QLabel#panel_title {
    color: #241b14;
    font-weight: 700;
    font-size: 11pt;
    min-height: 26px;
    max-height: 26px;
}
QLabel {
    color: #5b4736;
    min-height: 20px;
}
QLabel:disabled { color: #bfae9b; }
QPushButton {
    min-height: 30px;
    padding: 4px 14px;
    background: #fffaf2;
    border: 1px solid #decbb7;
    border-radius: 10px;
    color: #6d4728;
    font-weight: 600;
}
QPushButton:hover { background: #f4e9dc; border-color: #c69b69; }
QPushButton:pressed { background: #eadbcb; }
QPushButton:disabled { color: #b8a58f; background: #fbf8f3; border-color: #eee5da; }
QComboBox, QLineEdit, QSpinBox {
    min-height: 32px;
    max-height: 32px;
    background: #fffefa;
    border: 1px solid #e6d9cc;
    border-radius: 8px;
    color: #3a2b1f;
    padding: 0 10px;
}
QComboBox:focus, QLineEdit:focus, QSpinBox:focus {
    border-color: #b98552;
    background: #ffffff;
}
QComboBox:disabled {
    color: #b8a58f;
    background: #fbf8f3;
    border-color: #eee5da;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QCheckBox {
    color: #3a2b1f;
    spacing: 12px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #d8c8b8;
    background: #fffefa;
}
QCheckBox::indicator {
    border-radius: 5px;
}
QCheckBox::indicator:checked {
    background: #a87443;
    border-color: #a87443;
}</string>
        </property>
