   <property name="styleSheet">
    <string notr="true">QMenuBar {
    background: #fffdf9;
    color: #2e2218;
    border-bottom: 1px solid #eee5da;
    padding: 5px 18px;
    spacing: 16px;
}
QMenuBar::item {
    background: transparent;
    padding: 8px 14px;
    border-radius: 8px;
}
QMenuBar::item:selected {
    background: #f3ece4;
}
QMenu {
    background: #fffdf9;
    border: 1px solid #eadfd3;
    border-radius: 8px;
    padding: 6px;
}
QMenu::item {
    padding: 7px 24px;
    border-radius: 6px;
}
QMenu::item:selected {
    background: #f3ece4;
}</string>
